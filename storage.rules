rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =====================================================
    // FUNCIONES AUXILIARES
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/usuarios/$(request.auth.uid);
    }

    function profileExists() {
      return signedIn() &&
             firestore.exists(profilePath());
    }

    function profile() {
      return firestore.get(profilePath()).data;
    }

    function active() {
      return profileExists() &&
             profile().active == true;
    }

    function roleIs(roleName) {
      return active() &&
             profile().role == roleName;
    }

    // =====================================================
    // BUILD-119A5A — AUTORIZACIÓN TERRITORIAL PARA STORAGE
    // =====================================================

    function territorialGrantPath() {
      return /databases/(default)/documents/territorialAccessGrants/$(request.auth.uid);
    }

    function territorialGrantExists() {
      return signedIn() &&
             firestore.exists(territorialGrantPath());
    }

    function territorialGrant() {
      return firestore.get(territorialGrantPath()).data;
    }

    function territorialGrantValid() {
      return active() &&
             territorialGrantExists() &&
             territorialGrant().active == true &&
             territorialGrant().uid == request.auth.uid &&
             territorialGrant().personId == profile().personId &&
             territorialGrant().campaignId == profile().campaignId &&
             (
               territorialGrant().mode == "demo" ||
               territorialGrant().mode == "operational"
             ) &&
             territorialGrant().startsAt <= request.time &&
             request.time < territorialGrant().expiresAt &&
             territorialGrant().revokedAt == null;
    }

    function territorialPermission(permissionName) {
      return territorialGrantValid() &&
             territorialGrant().permissions is list &&
             permissionName in territorialGrant().permissions;
    }

    function storageRecordModeMatches(metadata) {
      return
        (
          territorialGrant().mode == "demo" &&
          metadata.get("recordMode", "") == "demo" &&
          metadata.get("productionEligible", "") == "false"
        )
        ||
        (
          territorialGrant().mode == "operational" &&
          metadata.get("recordMode", "") == "production" &&
          metadata.get("productionEligible", "") == "true"
        );
    }

    function storageScopeMatches(metadata) {
      return
        territorialGrant().scopeType == "campaign"
        ||
        (
          territorialGrant().scopeType == "municipality" &&
          metadata.get("municipalityId", "") ==
          territorialGrant().municipalityId
        )
        ||
        (
          territorialGrant().scopeType == "structure" &&
          metadata.get("municipalityId", "") ==
          territorialGrant().municipalityId &&
          metadata.get("structureId", "") ==
          territorialGrant().structureId
        )
        ||
        (
          territorialGrant().scopeType == "brigade" &&
          metadata.get("brigadeId", "") ==
          territorialGrant().brigadeId
        );
    }

    function territorialStorageReadAllowed(campaignId, metadata) {
      return territorialPermission("read") &&
             campaignId == profile().campaignId &&
             campaignId == territorialGrant().campaignId &&
             storageRecordModeMatches(metadata) &&
             storageScopeMatches(metadata);
    }

    function territorialStorageCreateAllowed(campaignId, metadata) {
      return territorialPermission("write") &&
             campaignId == profile().campaignId &&
             campaignId == territorialGrant().campaignId &&
             metadata.get("uploaderUid", "") ==
             request.auth.uid &&
             metadata.get("territorialGrantId", "") ==
             territorialGrant().grantId &&
             metadata.get("territorialPersonId", "") ==
             territorialGrant().personId &&
             metadata.get("territorialGrantMode", "") ==
             territorialGrant().mode &&
             metadata.get("territorialScopeType", "") ==
             territorialGrant().scopeType &&
             storageRecordModeMatches(metadata) &&
             storageScopeMatches(metadata);
    }


    function missionPath(missionId) {
      return /databases/(default)/documents/misiones/$(missionId);
    }

    function missionExists(missionId) {
      return firestore.exists(
        missionPath(missionId)
      );
    }

    function mission(missionId) {
      return firestore.get(
        missionPath(missionId)
      ).data;
    }


    // =====================================================
    // EVIDENCIAS FOTOGRÁFICAS DE VISITAS
    // BUILD-119A5A
    //
    // Ruta:
    // visitas/{campaignId}/{visitId}/{fileName}
    //
    // Jerarquía NO concede acceso territorial.
    // Se requiere grant territorial activo.
    // =====================================================

    match /visitas/{campaignId}/{visitId}/{fileName} {

      allow read: if
        territorialStorageReadAllowed(
          campaignId,
          resource.metadata
        );

      allow create: if
        territorialStorageCreateAllowed(
          campaignId,
          request.resource.metadata
        ) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");

      allow update, delete: if false;
    }


    // =====================================================
    // EVIDENCIAS PRIVADAS DE MISIONES
    // BUILD-116
    //
    // Ruta:
    // missions/{campaignId}/{missionId}/evidence/{fileName}
    // =====================================================

    match /missions/{campaignId}/{missionId}/evidence/{fileName} {
      function missionAcceptsUpload(id) {
        let m = mission(id);
        return m.active == true &&
          (m.get('deadlineAt', null) == null || m.get('deadlineAt', null) == '' ||
           (m.get('deadlineAtMillis', null) is number && request.time.toMillis() < m.deadlineAtMillis));
      }

      // -------------------------------------------------
      // LEER — ADMINISTRADOR
      // -------------------------------------------------

      allow read: if roleIs("admin") &&
                  profile().campaignId ==
                  campaignId &&
                  missionExists(missionId) &&
                  mission(missionId).campaignId ==
                  campaignId;


      // -------------------------------------------------
      // LEER — COORDINADOR
      // MODELO ANTERIOR
      // -------------------------------------------------

      allow read: if roleIs("coordinador") &&
                  profile().campaignId ==
                  campaignId &&
                  missionExists(missionId) &&
                  mission(missionId).campaignId ==
                  campaignId &&
                  mission(missionId).brigadeId
                  in profile().brigadeIds;


      // -------------------------------------------------
      // LEER — NUEVA JERARQUÍA
      // BUILD-116
      //
      // Puede consultar la imagen:
      //
      // 1. La persona que recibió la misión.
      // 2. La persona que creó la misión.
      //
      // No permite consultar evidencia
      // de misiones ajenas.
      // -------------------------------------------------

      allow read: if active() &&
                  (
                    roleIs("coordinador_municipal") ||
                    roleIs("jefe_estructura") ||
                    roleIs("integrante") ||
                    roleIs("participante") ||
                    roleIs("colaborador_base")
                  ) &&
                  profile().campaignId ==
                  campaignId &&
                  missionExists(missionId) &&
                  mission(missionId).campaignId ==
                  campaignId &&
                  (
                    mission(missionId).assignedTo ==
                    request.auth.uid ||

                    mission(missionId).createdBy ==
                    request.auth.uid
                  );


      // -------------------------------------------------
      // CREAR — ADMINISTRADOR
      // -------------------------------------------------

      allow create: if missionAcceptsUpload(missionId) && roleIs("admin") &&
                    profile().campaignId ==
                    campaignId &&
                    missionExists(missionId) &&
                    mission(missionId).campaignId ==
                    campaignId &&
                    request.resource.size <
                    8 * 1024 * 1024 &&
                    request.resource.contentType
                    .matches("image/.*");


      // -------------------------------------------------
      // CREAR — COORDINADOR
      // MODELO ANTERIOR
      // -------------------------------------------------

      allow create: if missionAcceptsUpload(missionId) && roleIs("coordinador") &&
                    profile().campaignId ==
                    campaignId &&
                    missionExists(missionId) &&
                    mission(missionId).campaignId ==
                    campaignId &&
                    mission(missionId).brigadeId
                    in profile().brigadeIds &&
                    request.resource.size <
                    8 * 1024 * 1024 &&
                    request.resource.contentType
                    .matches("image/.*");


      // -------------------------------------------------
      // CREAR — DESTINATARIO
      // NUEVA JERARQUÍA / BUILD-116
      //
      // Solo la persona que recibió la misión
      // puede cargar evidencia.
      // -------------------------------------------------

      allow create: if missionAcceptsUpload(missionId) && active() &&
                    (
                      roleIs("coordinador_municipal") ||
                      roleIs("jefe_estructura") ||
                      roleIs("integrante") ||
                      roleIs("participante") ||
                      roleIs("colaborador_base")
                    ) &&
                    profile().campaignId ==
                    campaignId &&
                    missionExists(missionId) &&
                    mission(missionId).campaignId ==
                    campaignId &&
                    mission(missionId).assignedTo ==
                    request.auth.uid &&
                    request.resource.size <
                    8 * 1024 * 1024 &&
                    request.resource.contentType
                    .matches("image/.*");


      // -------------------------------------------------
      // INMUTABILIDAD DE EVIDENCIA
      // -------------------------------------------------

      // Ningún archivo puede reemplazarse
      // ni eliminarse desde el navegador.
      allow update, delete: if false;
    }


    // =====================================================
    // TODO LO DEMÁS
    // =====================================================

    match /{allPaths=**} {

      allow read, write: if false;
    }

  }

}
